# 忽略瓦片缓存与压制输出（体积庞大，云端已备份，禁止提交至 Git）
tiles/
output/
logs/

# 忽略临时配置文件（运行时动态生成）
_temp_*.yaml

# 忽略 Python 缓存
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python

# 忽略虚拟环境
venv/
.venv/
env/

# 忽略 IDE 配置
.vscode/
.idea/
*.suo
*.user

# 忽略 Shapefile 中间索引文件（只保留 .shp, .dbf, .prj, .shx）
*.cpg

# 忽略敏感凭证
cookie.txt
*.token
.env

# 忽略系统文件
Thumbs.db
.DS_Store
